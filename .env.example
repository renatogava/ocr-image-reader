# Chave do header X-Api-Key (obrigatória em produção / Swarm)
OCR_API_KEY=change-me-to-a-secure-key

# Path do binário Tesseract (Windows local). No Docker/Swarm não é necessário.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Idioma do modelo Tesseract
OCR_LANGUAGE=por

# Limite de tamanho da imagem (bytes)
MAX_IMAGE_BYTES=10485760

# Timeout para download de imageUrl (segundos)
DOWNLOAD_TIMEOUT_SECONDS=30

# --- Produção (Docker Swarm) ---
# Antes do stack deploy, exporte a chave no shell da VPS:
#   export OCR_API_KEY='sua-chave-forte'
# SP:  docker stack deploy -c docker-compose.ocr.yml ocr
# AMS: docker stack deploy -c docker-compose.ocr2.yml ocr
