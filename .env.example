# Chave compartilhada com o e-commerce (header X-Api-Key)
OCR_API_KEY=change-me-to-a-secure-key

# Path do binário Tesseract (Windows local). No Docker não é necessário.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Idioma do modelo Tesseract
OCR_LANGUAGE=por

# Limite de tamanho da imagem (bytes)
MAX_IMAGE_BYTES=10485760

# Timeout para download de imageUrl (segundos)
DOWNLOAD_TIMEOUT_SECONDS=30
