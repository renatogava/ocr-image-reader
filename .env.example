# Chave do header X-Api-Key (obrigatória em produção / Swarm)
OCR_API_KEY=change-me-to-a-secure-key

# Path do binário Tesseract (Windows local). No Docker/Swarm não é necessário.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Idioma do modelo Tesseract
OCR_LANGUAGE=por

# Limite de tamanho da imagem (bytes)
MAX_IMAGE_BYTES=10485760

# Timeout para download de imageUrl (segundos)
DOWNLOAD_TIMEOUT_SECONDS=30

# Motor de OCR: auto | tesseract | openai
# auto = Tesseract primeiro; se confiança < limiar (ou sem texto), usa Vision
OCR_ENGINE=auto

# Confiança mínima do Tesseract (0-100) para aceitar sem fallback Vision
OCR_CONFIDENCE_THRESHOLD=60

# --- OpenAI Vision (opcional; necessário para manuscritos / fallback) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_MAX_TOKENS=2000
# OPENAI_TIMEOUT_SECONDS=60

# Estruturação pós-OCR (data, cabeçalho, paciente, inscrição, posologia)
# Requer OPENAI_API_KEY. Desligue com OCR_STRUCTURE_ENABLED=false ou ?structure=false
OCR_STRUCTURE_ENABLED=true
# OPENAI_STRUCTURE_MODEL=gpt-4o-mini
# OPENAI_STRUCTURE_MAX_TOKENS=1500

# --- Produção (Docker Swarm) ---
# Antes do stack deploy, exporte a chave no shell da VPS:
#   export OCR_API_KEY='sua-chave-forte'
#   export OPENAI_API_KEY='sk-...'   # se usar Vision / estruturação
# SP:  docker stack deploy -c docker-compose.ocr.yml ocr
# AMS: docker stack deploy -c docker-compose.ocr2.yml ocr
